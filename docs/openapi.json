            },
            "type": "array",
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "CompleteTaskRequest": {
        "properties": {
          "employee_id": {
            "type": "string",
            "title": "Employee Id",
            "default": "alex-chen"
          }
        },
        "type": "object",
        "title": "CompleteTaskRequest"
      },
      "EquipmentRequest": {
        "properties": {
          "item_type": {
            "type": "string",
            "title": "Item Type",
            "default": "laptop"
          },
          "item_name": {
            "type": "string",
            "title": "Item Name"
          }
        },
        "type": "object",
        "required": [
          "item_name"
        ],
        "title": "EquipmentRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
