OPENAI_API_KEY=sk-your-key-here

# LLM Selection (OpenAI or Open-Source / Open-Weight LLMs)
# Default: gpt-4o-mini
# For Open-Weight models (Llama 3.1, Mistral, Qwen, DeepSeek):
# LLM_MODEL=llama-3.1-8b-instant
# LLM_BASE_URL=https://api.groq.com/openai/v1   # Or http://localhost:11434/v1 for local Ollama
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Local dev (outside Docker) — host is localhost
POSTGRES_USER=onboardai
POSTGRES_PASSWORD=onboardai
POSTGRES_DB=onboardai
DATABASE_URL=postgresql://onboardai:onboardai@localhost:5432/onboardai

# Docker Compose reads POSTGRES_* from this file and rewrites DATABASE_URL
# to use host `postgres` inside containers.

# pgAdmin UI at http://localhost:8080
PGADMIN_DEFAULT_EMAIL=admin@onboardai.com
PGADMIN_DEFAULT_PASSWORD=admin

# Eval JSON reports (default: <repo>/evals/results)
# EVALS_RESULTS_DIR=/app/evals/results

# Security
# Set a strong random key for admin routes. Leave empty to disable admin API key check (dev only).
ADMIN_API_KEY=change-me-to-a-strong-secret
SESSION_SECRET=onboardai-secure-session-secret-key-change-in-production
# Optional bootstrap credentials. Leave empty in dev mode to allow seamless demo access.
DEFAULT_ADMIN_PASSWORD=
DEFAULT_EMPLOYEE_PASSWORD=

# Comma-separated list of allowed CORS origins (default allows local dev ports)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
